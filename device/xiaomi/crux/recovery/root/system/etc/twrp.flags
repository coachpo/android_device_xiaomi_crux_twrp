# TWRP mount / backup / flash layout for crux (Xiaomi Mi 9 Pro 5G).
#
# Format (TWRP 12.1):
#   <mount point>  <fstype>  <device>  [device2]  flags=<a;b;c>
#
# Base: the proven crux TWRP image (twrp-proven-img/recovery.img, TWRP 3.3.1)
# converted to the TWRP 12.1 flags syntax, cross-checked against the stock
# partition names in the PE13 fstab and the official recovery image.
#
# Reminder: firmware partitions (modem / bluetooth / dsp / xbl / abl / ...) are
# listed for backup and image flashing. The Crux project policy is not to write
# bootloader / radio firmware from Android; keep that in mind when restoring.

# Boot / recovery / DTBO
/boot              emmc    /dev/block/bootdevice/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery          emmc    /dev/block/bootdevice/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1
/dtbo              emmc    /dev/block/bootdevice/by-name/dtbo         flags=display="DTBO";backup=1;flashimg=1

# System / vendor
/system_root       ext4    /dev/block/bootdevice/by-name/system       flags=display="System";backup=0;wipeingui
/system_image      emmc    /dev/block/bootdevice/by-name/system       flags=display="System Image";backup=1;flashimg=1
/vendor            ext4    /dev/block/bootdevice/by-name/vendor       flags=display="Vendor";backup=0;wipeingui
/vendor_image      emmc    /dev/block/bootdevice/by-name/vendor       flags=display="Vendor Image";backup=1;flashimg=1
/cust              ext4    /dev/block/bootdevice/by-name/cust         flags=display="Cust";wipeingui
/cust_image        emmc    /dev/block/bootdevice/by-name/cust         flags=display="Cust Image";backup=1;flashimg=1

# Data / cache / metadata
/cache             ext4    /dev/block/bootdevice/by-name/cache        flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/metadata          ext4    /dev/block/bootdevice/by-name/metadata     flags=display="Metadata";backup=1;wipeingui
/data              ext4    /dev/block/bootdevice/by-name/userdata     flags=fileencryption=ice,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M
/storage           auto    /data/media/0                              flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable

# Modem / firmware / BT / DSP
/firmware          vfat    /dev/block/bootdevice/by-name/modem        flags=display="Firmware";mounttodecrypt
/firmware_image    emmc    /dev/block/bootdevice/by-name/modem        flags=display="Firmware Image";backup=1;flashimg=1
/modem             emmc    /dev/block/bootdevice/by-name/modem        flags=display="Modem";backup=1
/bluetooth         emmc    /dev/block/bootdevice/by-name/bluetooth    flags=subpartitionof=/modem;backup=1
/dsp               ext4    /dev/block/bootdevice/by-name/dsp          flags=subpartitionof=/modem;backup=1
/dsp_image         emmc    /dev/block/bootdevice/by-name/dsp          flags=display="DSP Image";backup=1;flashimg=1

# EFS
/efs1              emmc    /dev/block/bootdevice/by-name/modemst1     flags=display="EFS";backup=1
/efs2              emmc    /dev/block/bootdevice/by-name/modemst2     flags=subpartitionof=/efs1;backup=1
/efsc              emmc    /dev/block/bootdevice/by-name/fsc          flags=subpartitionof=/efs1;backup=1
/efsg              emmc    /dev/block/bootdevice/by-name/fsg          flags=subpartitionof=/efs1;backup=1

# Persist
/persist           ext4    /dev/block/bootdevice/by-name/persist      flags=display="Persist";fsflags="ro"
/persist_image     emmc    /dev/block/bootdevice/by-name/persist      flags=display="Persist Image";backup=1;flashimg=1
/persistbak        ext4    /dev/block/bootdevice/by-name/persistbak   flags=display="Persist Backup";backup=1
/persistbak_image  emmc    /dev/block/bootdevice/by-name/persistbak   flags=display="Persist Backup Image";backup=1;flashimg=1

# Logos / misc / vbmeta
/splash            emmc    /dev/block/bootdevice/by-name/splash       flags=display="Boot Logo (Legacy)";backup=1;flashimg=1
/logo              emmc    /dev/block/bootdevice/by-name/logo         flags=display="Boot Logo";backup=1;flashimg=1
/logfs             vfat    /dev/block/bootdevice/by-name/logfs        flags=display="Logfs";backup=1
/logfs_image       emmc    /dev/block/bootdevice/by-name/logfs        flags=display="Logfs Image";backup=1;flashimg=1
/misc              emmc    /dev/block/bootdevice/by-name/misc         flags=display="Misc"
/vbmeta            emmc    /dev/block/bootdevice/by-name/vbmeta       flags=display="VBMeta";backup=1;flashimg=1

# Miscellaneous stock partitions
/frp               emmc    /dev/block/bootdevice/by-name/frp          flags=display="FRP"
/ddr               emmc    /dev/block/bootdevice/by-name/ddr          flags=display="DDR"
/devinfo           emmc    /dev/block/bootdevice/by-name/devinfo      flags=display="Devinfo"
/keystore          emmc    /dev/block/bootdevice/by-name/keystore     flags=display="Keystore"
/ssd               emmc    /dev/block/bootdevice/by-name/ssd          flags=display="SSD"

# Bootloader / TrustZone firmware (backup only by policy; do not flash casually)
/abl               emmc    /dev/block/bootdevice/by-name/abl          flags=display="ABL";backup=1;flashimg=1
/xbl               emmc    /dev/block/bootdevice/by-name/xbl          flags=display="XBL";backup=1;flashimg=1
/tz                emmc    /dev/block/bootdevice/by-name/tz           flags=display="TZ";backup=1;flashimg=1
/msadp             emmc    /dev/block/bootdevice/by-name/msadp        flags=display="MSADP";backup=1;flashimg=1
/apdp              emmc    /dev/block/bootdevice/by-name/apdp         flags=display="APDP";backup=1;flashimg=1
/cmnlib            emmc    /dev/block/bootdevice/by-name/cmnlib       flags=display="CMNLIB";backup=1;flashimg=1
/cmnlib64          emmc    /dev/block/bootdevice/by-name/cmnlib64     flags=display="CMNLIB64";backup=1;flashimg=1
/keymaster         emmc    /dev/block/bootdevice/by-name/keymaster    flags=display="Keymaster";backup=1;flashimg=1
/hyp               emmc    /dev/block/bootdevice/by-name/hyp          flags=display="HYP";backup=1;flashimg=1
/devcfg            emmc    /dev/block/bootdevice/by-name/devcfg       flags=display="Devcfg";backup=1;flashimg=1

# USB OTG
/usb_otg           vfat    /dev/block/sdg1  /dev/block/sdg             flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
