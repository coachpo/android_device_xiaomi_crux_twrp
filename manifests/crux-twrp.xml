<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for a TWRP 12.1 (3.7.1_12) build for the Xiaomi Mi 9 Pro 5G
    (crux).

    Usage (inside the TWRP tree, after repo init):
        mkdir -p .repo/local_manifests
        cp manifests/crux-twrp.xml .repo/local_manifests/
        repo sync

    The kernel project follows the crux-pe13-cepheus branch (the PE13 Cepheus
    baseline migration; Linux 4.14.305). The expected source revision is
    b38f5a5c8cacddaa2e547c466876d22528e1c7e5; scripts/build-twrp.sh only warns
    on mismatch. TWRP builds the kernel from source through
    vendor/twrp/build/tasks/kernel.mk.
-->
<manifest>
    <project name="coachpo/android_device_xiaomi_crux_twrp"
             path="device/xiaomi/crux"
             remote="github"
             revision="main" />

    <project name="coachpo/kernel_xiaomi_crux"
             path="kernel/xiaomi/crux"
             remote="github"
             revision="crux-pe13-cepheus"
             clone-depth="1" />
    <!--
        Expected source revision:
        b38f5a5c8cacddaa2e547c466876d22528e1c7e5 (2026-10-04 branch tip:
        PE official Cepheus base f4048f154b51, Linux 4.14.305, the 15
        migration commits and the first-Hibern8 UFS trace).
        scripts/build-twrp.sh warns if the checkout differs.
    -->
</manifest>
