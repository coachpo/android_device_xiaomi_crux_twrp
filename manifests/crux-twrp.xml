<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for a TWRP 12.1 (3.7.1_12) build for the Xiaomi Mi 9 Pro 5G
    (crux).

    Usage (inside the TWRP tree, after repo init):
        mkdir -p .repo/local_manifests
        cp manifests/crux-twrp.xml .repo/local_manifests/
        repo sync

    The kernel project is pinned to branch thirteen-plus at the verified PE13
    source revision b5ef11095c5389f937514d59da39c35cd244d971 (Linux
    4.14.357-openela "Marisa"); scripts/build-twrp.sh aborts on mismatch
    unless ALLOW_KERNEL_REVISION_MISMATCH=1 is set.
    TWRP builds the kernel from source through vendor/twrp/build/tasks/kernel.mk.
-->
<manifest>
    <project name="coachpo/android_device_xiaomi_crux_twrp"
             path="device/xiaomi/crux"
             remote="github"
             revision="main" />

    <project name="coachpo/kernel_xiaomi_crux"
             path="kernel/xiaomi/crux"
             remote="github"
             revision="b5ef11095c5389f937514d59da39c35cd244d971"
             clone-depth="1" />
    <!--
        Pinned revision:
        b5ef11095c5389f937514d59da39c35cd244d971 (2026-09-15,
        "crux: correct build configuration and CPU cluster handling").
        scripts/setup-twrp.sh and scripts/build-twrp.sh carry the same pin;
        build-twrp.sh aborts if the checkout differs.
    -->
</manifest>
