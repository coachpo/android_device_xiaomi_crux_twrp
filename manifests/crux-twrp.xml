<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for a TWRP 12.1 (3.7.1_12) build for the Xiaomi Mi 9 Pro 5G
    (crux).

    Usage (inside the TWRP tree, after repo init):
        mkdir -p .repo/local_manifests
        cp manifests/crux-twrp.xml .repo/local_manifests/
        repo sync

    The kernel project follows the thirteen-plus branch. The expected PE13
    source revision is c5afe30f211bec03f1a9d10f90eac4a57e792818 (Linux
    4.14.357-openela "Marisa"); scripts/build-twrp.sh only warns on mismatch.
    TWRP builds the kernel from source through vendor/twrp/build/tasks/kernel.mk.
-->
<manifest>
    <project name="coachpo/android_device_xiaomi_crux_twrp"
             path="device/xiaomi/crux"
             remote="github"
             revision="main" />

    <project name="coachpo/kernel_xiaomi_crux"
             path="kernel/xiaomi/crux"
             remote="github"
             revision="thirteen-plus"
             clone-depth="1" />
    <!--
        Expected source revision:
        c5afe30f211bec03f1a9d10f90eac4a57e792818 (2026-10-03 branch tip:
        pstore config debb0e0c4e50, selftest cleanup 02ac3777e4c7, gitignore
        c5afe30f211b). scripts/build-twrp.sh warns if the checkout differs.
    -->
</manifest>
