<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for a TWRP 12.1 (3.7.1_12) build for the Xiaomi Mi 9 Pro 5G
    (crux).

    Usage (inside the TWRP tree, after repo init):
        mkdir -p .repo/local_manifests
        cp manifests/crux-twrp.xml .repo/local_manifests/
        repo sync

    The kernel is the PE13 Crux kernel pinned at the same commit as the PE13
    source lock (coachpo/crux-pe13-distributed config/cloud-source-manifest.json,
    kernel/xiaomi/crux-pe-cepheus); scripts/build-twrp.sh refuses another
    checkout. TWRP builds it from source through vendor/twrp/build/tasks/kernel.mk.
    Set CRUX_KERNEL_SOURCE for scripts/setup-twrp.sh to use a git worktree of an
    existing kernel checkout instead of a second clone.
-->
<manifest>
    <remote name="crux-github" fetch="https://github.com/" />
    <remote name="crux-gitlab" fetch="https://gitlab.com/" />
    <project name="coachpo/android_device_xiaomi_crux_twrp"
             path="crux-device-source"
             remote="crux-github"
             revision="main" />

    <project name="coachpo/kernel_xiaomi_crux"
             path="kernel/xiaomi/crux"
             remote="crux-github"
             revision="2a6319afbb1b9d7d29f7868eda5de27e63e0f2d9"
             upstream="thirteen"
             clone-depth="1" />
    <!-- Same Prelude Clang 16.0.2 revision as the verified local PE/TWRP build. -->
    <project name="jjpprrrr/prelude-clang"
             path="prebuilts/clang/host/linux-x86/clang-prelude"
             remote="crux-gitlab"
             revision="ac8fce34dc0f6918672100d7a6e867a66b8afa8f"
             clone-depth="1" />
</manifest>
